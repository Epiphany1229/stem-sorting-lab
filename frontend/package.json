{
  "name": "stem-sorting-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stage-1 frontend shell for the bilingual Python sorting + Hong Kong weather STEM site.",
  "scripts": {
    "dev": "node --require ./scripts/sandbox-guard.cjs node_modules/vite/bin/vite.js",
    "build": "node --require ./scripts/sandbox-guard.cjs node_modules/vite/bin/vite.js build",
    "preview": "node --require ./scripts/sandbox-guard.cjs node_modules/vite/bin/vite.js preview",
    "test": "node --require ./scripts/sandbox-guard.cjs node_modules/vitest/vitest.mjs",
    "test:run": "node --require ./scripts/sandbox-guard.cjs node_modules/vitest/vitest.mjs run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "plotly.js-dist-min": "^4.1.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-plotly.js": "^4.1.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
