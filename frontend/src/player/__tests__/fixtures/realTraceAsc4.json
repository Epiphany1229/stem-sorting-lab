      {
        "line_id": "L17",
        "lineno": 17,
        "text": "def bubble_sort(",
        "kind": "normal"
      },
      {
        "line_id": "L18",
        "lineno": 18,
        "text": "    values: Sequence[float],",
        "kind": "normal"
      },
      {
        "line_id": "L19",
        "lineno": 19,
        "text": "    direction: str = \"asc\",",
        "kind": "normal"
      },
      {
        "line_id": "L20",
        "lineno": 20,
        "text": "    early_exit: bool = True,",
        "kind": "normal"
      },
      {
        "line_id": "L21",
        "lineno": 21,
        "text": "    tracer: Tracer | None = None,",
        "kind": "normal"
      },
      {
        "line_id": "L22",
        "lineno": 22,
        "text": ") -> list[float]:",
        "kind": "normal"
      },
      {
        "line_id": "L23",
        "lineno": 23,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L24",
        "lineno": 24,
        "text": "    recorder: Tracer = tracer if tracer is not None else _NULL_RECORDER",
        "kind": "normal"
      },
      {
        "line_id": "L25",
        "lineno": 25,
        "text": "    arr = list(values)",
        "kind": "normal"
      },
      {
        "line_id": "L26",
        "lineno": 26,
        "text": "    n = len(arr)",
        "kind": "normal"
      },
      {
        "line_id": "L27",
        "lineno": 27,
        "text": "    descending = direction == \"desc\"",
        "kind": "normal"
      },
      {
        "line_id": "L28",
        "lineno": 28,
        "text": "    passes = 0",
        "kind": "normal"
      },
      {
        "line_id": "L29",
        "lineno": 29,
        "text": "    for i in range(n - 1):",
        "kind": "normal"
      },
      {
        "line_id": "L30",
        "lineno": 30,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L31",
        "lineno": 31,
        "text": "        recorder.emit_mark_sorted(pass_index=i)",
        "kind": "trace"
      },
      {
        "line_id": "L32",
        "lineno": 32,
        "text": "        passes += 1",
        "kind": "normal"
      },
      {
        "line_id": "L33",
        "lineno": 33,
        "text": "        swapped = False",
        "kind": "normal"
      },
      {
        "line_id": "L34",
        "lineno": 34,
        "text": "        for j in range(n - 1 - i):",
        "kind": "normal"
      },
      {
        "line_id": "L35",
        "lineno": 35,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L36",
        "lineno": 36,
        "text": "            recorder.emit_compare(i=j, j=j + 1, pass_index=i)",
        "kind": "trace"
      },
      {
        "line_id": "L37",
        "lineno": 37,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L38",
        "lineno": 38,
        "text": "            if (arr[j] < arr[j + 1]) if descending else (arr[j] > arr[j + 1]):",
        "kind": "normal"
      },
      {
        "line_id": "L39",
        "lineno": 39,
        "text": "                arr[j], arr[j + 1] = arr[j + 1], arr[j]",
        "kind": "normal"
      },
      {
        "line_id": "L40",
        "lineno": 40,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L41",
        "lineno": 41,
        "text": "                recorder.emit_swap(i=j, j=j + 1, pass_index=i)",
        "kind": "trace"
      },
      {
        "line_id": "L42",
        "lineno": 42,
        "text": "                swapped = True",
        "kind": "normal"
      },
      {
        "line_id": "L43",
        "lineno": 43,
        "text": "        if early_exit and not swapped:",
        "kind": "normal"
      },
      {
        "line_id": "L44",
        "lineno": 44,
        "text": "            break",
        "kind": "normal"
      },
      {
        "line_id": "L45",
        "lineno": 45,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L46",
        "lineno": 46,
        "text": "    early_stop = early_exit and passes < n - 1",
        "kind": "normal"
      },
      {
        "line_id": "L47",
        "lineno": 47,
        "text": "    recorder.emit_done(pass_index=passes - 1, triggered=early_stop, finalized=tuple(range(n)))",
        "kind": "trace"
      },
      {
        "line_id": "L48",
        "lineno": 48,
        "text": "    return arr",
        "kind": "normal"
      }
    ]
