  "code": {
    "language": "python",
    "lines": [
      {
        "line_id": "L1",
        "lineno": 1,
        "text": "\"\"\"冒泡排序：唯一可信源码。",
        "kind": "normal"
      },
      {
        "line_id": "L2",
        "lineno": 2,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L3",
        "lineno": 3,
        "text": "学生看到的代码就是这里被真实执行的代码：轨迹插桩 ``recorder.emit_*`` 直接写在",
        "kind": "normal"
      },
      {
        "line_id": "L4",
        "lineno": 4,
        "text": "函数体里，展示时按行号标记为 trace 行，不存在第二份“教学版”源码。",
        "kind": "normal"
      },
      {
        "line_id": "L5",
        "lineno": 5,
        "text": "\"\"\"",
        "kind": "normal"
      },
      {
        "line_id": "L6",
        "lineno": 6,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L7",
        "lineno": 7,
        "text": "from __future__ import annotations",
        "kind": "normal"
      },
      {
        "line_id": "L8",
        "lineno": 8,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L9",
        "lineno": 9,
        "text": "from collections.abc import Sequence",
        "kind": "normal"
      },
      {
        "line_id": "L10",
        "lineno": 10,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L11",
        "lineno": 11,
        "text": "from backend.app.trace.recorder import NullRecorder, Tracer",
        "kind": "normal"
      },
      {
        "line_id": "L12",
        "lineno": 12,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L13",
        "lineno": 13,
        "text": "# 未传入 tracer 时使用全空接收器：纯算法调用不产生任何轨迹数据结构。",
        "kind": "normal"
      },
      {
        "line_id": "L14",
        "lineno": 14,
        "text": "_NULL_RECORDER: Tracer = NullRecorder()",
        "kind": "normal"
      },
      {
        "line_id": "L15",
        "lineno": 15,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L16",
        "lineno": 16,
        "text": "",
        "kind": "normal"
      },
      {
        "line_id": "L17",
        "lineno": 17,
        "text": "def bubble_sort(",
        "kind": "normal"
      },
      {
        "line_id": "L18",
        "lineno": 18,
        "text": "    values: Sequence[float],",
        "kind": "normal"
      },
      {
        "line_id": "L19",
        "lineno": 19,
        "text": "    direction: str = \"asc\",",
        "kind": "normal"
      },
      {
        "line_id": "L20",
        "lineno": 20,
        "text": "    early_exit: bool = True,",
        "kind": "normal"
      },
      {
        "line_id": "L21",
        "lineno": 21,
        "text": "    tracer: Tracer | None = None,",
        "kind": "normal"
      },
      {
        "line_id": "L22",
        "lineno": 22,
        "text": ") -> list[float]:",
        "kind": "normal"
      },
      {
        "line_id": "L23",
        "lineno": 23,
        "text": "    \"\"\"冒泡排序：返回排序后的新列表，传入 tracer 时同步产生真实执行轨迹。\"\"\"",
        "kind": "normal"
      },
      {
        "line_id": "L24",
        "lineno": 24,
        "text": "    recorder: Tracer = tracer if tracer is not None else _NULL_RECORDER",
        "kind": "normal"
      },
      {
        "line_id": "L25",
        "lineno": 25,
        "text": "    arr = list(values)",
        "kind": "normal"
      },
      {
        "line_id": "L26",
        "lineno": 26,
        "text": "    n = len(arr)",
        "kind": "normal"
      },
      {
        "line_id": "L27",
        "lineno": 27,
        "text": "    descending = direction == \"desc\"",
        "kind": "normal"
      },
      {
        "line_id": "L28",
        "lineno": 28,
        "text": "    passes = 0",
        "kind": "normal"
      },
      {
        "line_id": "L29",
        "lineno": 29,
        "text": "    for i in range(n - 1):",
        "kind": "normal"
      },
      {
        "line_id": "L30",
        "lineno": 30,
        "text": "        # 进入新一轮：上一轮冒泡到末尾的元素已经确定最终位置。",
        "kind": "normal"
      },
      {
        "line_id": "L31",
        "lineno": 31,
        "text": "        recorder.emit_mark_sorted(pass_index=i)",
        "kind": "trace"
      },
      {
        "line_id": "L32",
        "lineno": 32,
        "text": "        passes += 1",
        "kind": "normal"
      },
      {
        "line_id": "L33",
        "lineno": 33,
        "text": "        swapped = False",
        "kind": "normal"
      },
      {
        "line_id": "L34",
        "lineno": 34,
        "text": "        for j in range(n - 1 - i):",
        "kind": "normal"
      },
      {
        "line_id": "L35",
        "lineno": 35,
        "text": "            # 先记录“即将比较”，此时数组还没有任何变化。",
        "kind": "normal"
      },
      {
        "line_id": "L36",
        "lineno": 36,
        "text": "            recorder.emit_compare(i=j, j=j + 1, pass_index=i)",
        "kind": "trace"
      },
      {
        "line_id": "L37",
        "lineno": 37,
        "text": "            # 升序：左 > 右 才交换；降序：左 < 右 才交换。",
        "kind": "normal"
      },
      {
        "line_id": "L38",
        "lineno": 38,
        "text": "            if (arr[j] < arr[j + 1]) if descending else (arr[j] > arr[j + 1]):",
        "kind": "normal"
      },
      {
        "line_id": "L39",
        "lineno": 39,
        "text": "                arr[j], arr[j + 1] = arr[j + 1], arr[j]",
        "kind": "normal"
      },
      {
        "line_id": "L40",
        "lineno": 40,
        "text": "                # 交换赋值之后记录，才能拿到真实的前后状态。",
        "kind": "normal"
      },
      {
        "line_id": "L41",
        "lineno": 41,
        "text": "                recorder.emit_swap(i=j, j=j + 1, pass_index=i)",
        "kind": "trace"
      },
      {
        "line_id": "L42",
        "lineno": 42,
        "text": "                swapped = True",
        "kind": "normal"
      },
      {
        "line_id": "L43",
        "lineno": 43,
        "text": "        if early_exit and not swapped:",
        "kind": "normal"
      },
      {
        "line_id": "L44",
        "lineno": 44,
        "text": "            break",
        "kind": "normal"
      },
      {
        "line_id": "L45",
        "lineno": 45,
        "text": "    # 只有“还有轮次没跑就退出”才算提前结束；最后一轮自然退出不算。",
        "kind": "normal"
      },
      {
        "line_id": "L46",
        "lineno": 46,
        "text": "    early_stop = early_exit and passes < n - 1",
        "kind": "normal"
      },
      {
        "line_id": "L47",
        "lineno": 47,
        "text": "    recorder.emit_done(pass_index=passes - 1, triggered=early_stop, finalized=tuple(range(n)))",
        "kind": "trace"
      },
      {
        "line_id": "L48",
        "lineno": 48,
        "text": "    return arr",
        "kind": "normal"
      }
    ]
  },
