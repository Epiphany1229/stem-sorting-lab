# =============================================================================
# 环境变量示例文件（复制为 .env 后按需修改；切勿提交真实密钥）
# 说明：本文件不含任何真实密钥，也没有可选的第三方大模型 API。
#       字段名与环境变量名一一对应（pydantic-settings 不区分大小写）。
# =============================================================================

# ---------- 应用基础信息 ----------
# 应用名称，显示在 OpenAPI 文档标题与 /docs 页面
APP_NAME=STEM Sorting & Weather Lab API
# 应用版本号
APP_VERSION=0.1.0
# 调试模式：true 时错误响应更详细，仅限本地开发
DEBUG=false
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 允许跨域的前端地址，必须写成 JSON 数组（禁止使用 "*" 通配）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------- 数据库（阶段 1 仅占位，阶段 3 入库时启用） ----------
DATABASE_URL=sqlite:///./app.db

# ---------- 香港天文台（HKO）数据源 ----------
# 是否允许访问外部数据源；离线演示或测试时置为 false
EXTERNAL_FETCH_ENABLED=true
# 天文台实时天气接口基址（阶段 1 占位；阶段 3 仅用于来源说明）
HKO_BASE_URL=https://data.weather.gov.hk/weatherAPI/opendata/weather.php
# 逐日历史月表接口基址（CLMMAXT / CLMMINT / CLMTEMP 共用）
HKO_OPENDATA_URL=https://data.weather.gov.hk/weatherAPI/opendata/opendata.php
# 同一上游资源的抓取冷却时间（秒），用于合并并发请求、避免重复访问
FETCH_COOLDOWN_SECONDS=300
# 每日上游请求总预算（次），超出后拒绝并给出可理解提示
FETCH_DAILY_BUDGET=500
# 单次上游请求超时（秒）
FETCH_TIMEOUT_SECONDS=10.0
# 上游响应缓存有效期（秒）
FETCH_CACHE_TTL_SECONDS=900
# 连续失败达到该次数后熔断，暂停访问上游
FETCH_CIRCUIT_FAILURE_THRESHOLD=5
# 同主机两次请求之间的最小间隔（秒）；合规取数硬要求 ≥ 3 秒，不建议调小
FETCH_MIN_INTERVAL_SECONDS=3.0
# 附加到最小间隔上的随机抖动上限（秒）
FETCH_JITTER_SECONDS=0.6
# 5xx / 超时的额外重试次数上限（指数退避）
FETCH_MAX_RETRIES=3
# 指数退避的基准秒数（第 n 次重试等待 base * 2**n 秒）
FETCH_RETRY_BACKOFF_SECONDS=1.0
# 收到 403 后熔断的时长（分钟）
CIRCUIT_BREAKER_MINUTES=30
# 单 worker 抓取租约的有效期（秒）；跨进程保证同时只有一个抓取者
FETCH_LEASE_SECONDS=120
# 是否允许演示模式（只读 sample_data/demo 下的官方快照，不写入数据库）
DEMO_MODE_ENABLED=true
# 官方 39 站字典路径；留空表示使用包内置的 stations.json
STATION_REGISTRY_PATH=
# 演示数据样本路径（相对仓库根目录或绝对路径）
DEMO_DATA_PATH=sample_data/demo/hko_demo_2026-09.csv

# ---------- HTTP 客户端 ----------
# 是否读取系统代理环境变量。
# 本机实测（见 docs/environment-report.md）：trust_env=true 会走注册表代理导致 TLS 中断，
# 必须为 false；阶段 3 的 HKO 客户端也须固定 httpx.Client(trust_env=False)。
HTTP_TRUST_ENV=false

# ---------- 后台自动同步（阶段 5.1） ----------
# 是否启用启动自检 + 每 N 小时一次的近期数据静默同步。
# 自动化测试/离线演示环境应设为 false；生产环境默认 true。
AUTO_SYNC_ENABLED=true
# 两次检查之间的间隔小时数（默认 24h）。
AUTO_SYNC_INTERVAL_HOURS=24
# 每次补数的天数（默认 35，覆盖默认 30 天窗口并留冗余）。
AUTO_SYNC_DAYS=35
# 参与自动同步的核心测站（逗号分隔，必须是官方 39 站之一）。
AUTO_SYNC_STATIONS=HKO,KP,SHA
# 单轮同步允许的最大尝试次数（超过即放弃本轮，只记日志）。
AUTO_SYNC_MAX_ATTEMPTS=3
