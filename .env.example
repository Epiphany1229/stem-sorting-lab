# =============================================================================
# 环境变量示例文件（复制为 .env 后按需修改；切勿提交真实密钥）
# 说明：本文件不含任何真实密钥，也没有可选的第三方大模型 API。
#       字段名与环境变量名一一对应（pydantic-settings 不区分大小写）。
# =============================================================================

# ---------- 应用基础信息 ----------
# 应用名称，显示在 OpenAPI 文档标题与 /docs 页面
APP_NAME=STEM Sorting & Weather Lab API
# 应用版本号
APP_VERSION=0.1.0
# 调试模式：true 时错误响应更详细，仅限本地开发
DEBUG=false
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 允许跨域的前端地址，必须写成 JSON 数组（禁止使用 "*" 通配）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------- 数据库（阶段 1 仅占位，阶段 3 入库时启用） ----------
DATABASE_URL=sqlite:///./app.db

# ---------- 香港天文台（HKO）数据源 ----------
# 是否允许访问外部数据源；离线演示或测试时置为 false
EXTERNAL_FETCH_ENABLED=true
# 天文台开放数据接口基址（固定可信地址，服务端不提供任意 URL 抓取能力）
HKO_BASE_URL=https://data.weather.gov.hk/weatherAPI/opendata/weather.php
# 同一上游资源的抓取冷却时间（秒），用于合并并发请求、避免重复访问
FETCH_COOLDOWN_SECONDS=300
# 每日上游请求总预算（次），超出后拒绝并给出可理解提示
FETCH_DAILY_BUDGET=500
# 单次上游请求超时（秒）
FETCH_TIMEOUT_SECONDS=10.0
# 上游响应缓存有效期（秒）
FETCH_CACHE_TTL_SECONDS=900
# 连续失败达到该次数后熔断，暂停访问上游
FETCH_CIRCUIT_FAILURE_THRESHOLD=5

# ---------- HTTP 客户端 ----------
# 是否读取系统代理环境变量。
# 本机实测（见 docs/environment-report.md）：trust_env=true 会走注册表代理导致 TLS 中断，
# 必须为 false；阶段 3 的 HKO 客户端也须固定 httpx.Client(trust_env=False)。
HTTP_TRUST_ENV=false
